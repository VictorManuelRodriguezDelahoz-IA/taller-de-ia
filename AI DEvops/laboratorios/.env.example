# Copia este archivo a .env SOLO si vas a usar modelos reales.
# Los laboratorios funcionan completos sin ninguna clave.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Velocidad del simulador: fraccion de la latencia simulada que se espera de verdad.
# 0.05 = una llamada "de 800 ms" bloquea 40 ms reales. Subelo si quieres ver la
# latencia en tiempo real; bajalo a 0 si tienes prisa.
LAB_VELOCIDAD=0.05
